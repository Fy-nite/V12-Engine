<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Docs\*.aux" />
    <None Remove="Docs\*.log" />
    <None Remove="Docs\*.out" />
    <None Remove="Docs\*.pdf" />
    <None Remove="Docs\*.synctex.gz" />
    <None Remove="Docs\*.toc" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Templates\Gridspace.xml" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Glue\" />
    <Folder Include="Properties\" />
    <Folder Include="Tests\" />
  </ItemGroup>

  <ItemGroup>
  <PackageReference Include="AssimpNetter" Version="6.0.4" />
  <PackageReference Include="LiteNetLib" Version="1.1.0" />
  <PackageReference Include="MongoDB.Bson" Version="2.25.0" />
  <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
  <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Gridspace.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
 